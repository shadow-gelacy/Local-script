Entity:SetCallback("OnSpawned", function()
    task.wait(0.1)
    ConfigureCrucifix(Entity.Model)
end)

Entity:SetCallback("OnDespawned", function()
    if achievementGiven then return end
    achievementGiven = true

    pcall(function()
        Achievement({
            Title = "how why?",
            Desc = "Don't leave hiding spot",
            Reason = "Encounter Smiler.",
            Image = MODEL_ID
        })
    end)
end)

local function connectCharacter(character)
    local humanoid = character:WaitForChild("Humanoid")
    humanoid.Died:Connect(playJumpscare)
end

if LocalPlayer.Character then
    task.spawn(connectCharacter, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(connectCharacter)

Entity:Run()
print("[Smiler] Entity loaded")
