local Workspace = game:GetService("Workspace")

local Spawner = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

local Achievement = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
))()

local MODEL_ID = "rbxassetid://16618965725"
local CRUCIFIX_COLOR = Color3.fromRGB(255, 60, 60)

local achievementGiven = false

local function ConfigureCrucifix(model)
    if not model or not model:IsA("Model") then
        return
    end

    model:SetAttribute("IsCustomEntity", true)
    model:SetAttribute("EntityName", "Smiler")
    model:SetAttribute("CrucifixCompatible", true)
    model:SetAttribute("CanBeCrucified", true)
    model:SetAttribute("CrucifixResist", false)
    model:SetAttribute("CrucifixColor", CRUCIFIX_COLOR)
    model:SetAttribute("GoingToHell", false)

    if not model.PrimaryPart then
        local root =
            model:FindFirstChild("HumanoidRootPart", true)
            or model:FindFirstChild("Root", true)
            or model:FindFirstChildWhichIsA("BasePart", true)

        if root then
            model.PrimaryPart = root
        end
    end
end

local Entity = Spawner:Create({
    Entity = {
        Name = "smiler",
        Asset = MODEL_ID,
        HeightOffset = 2
    },

    Movement = {
        Speed = 716,
        Delay = 16,
        Reversed = false
    },

    Damage = {
        Enabled = true,
        Range = 45,
        Amount = 367,
        IgnoreHiding = false
    },

    Lights = {
        Flicker = {
            Enabled = true,
            Duration = 12
        },
        Shatter = true,
        Repair = false
    },

    Earthquake = {
        Enabled = false
    },

    CameraShake = {
        Enabled = true,
        Values = {30, 57, 0.1, 0.4},
        Range = 100
    },

    Rebounding = {
        Enabled = true,
        Type = "Ambush",
        Min = 11,
