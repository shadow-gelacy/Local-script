--// Services
local Players = game:GetService("Players")

local player = Players.LocalPlayer

--//==================================================
--// ENTITY SPAWNER
--//==================================================

local Spawner = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"
))()

--//==================================================
--// ACHIEVEMENT GIVER
--//==================================================

local achievementGiver = loadstring(
	game:HttpGet(
		"https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"
	)
)()

--//==================================================
--// CONFIG
--//==================================================

local MODEL_ID = "rbxassetid://16618965725"

local JUMPSCARE_URL =
	"https://raw.githubusercontent.com/shadow-gelacy/Local-script/refs/heads/main/IMG_1321.gif"

local JUMPSCARE_FILE = "SmilerJumpscare.gif"

local achievementGiven = false
local jumpscareShown = false
local healthConnection = nil

--//==================================================
--// ACHIEVEMENT
--//==================================================

local function GiveAchievement()
	if achievementGiven then
		return
	end

	achievementGiven = true

	pcall(function()
		achievementGiver({
			Title = "how why?",
			Desc = "Don't leave hiding spot",
			Reason = "Encounter smiler.",
			Image = MODEL_ID
		})
	end)
end

--//==================================================
--// DOWNLOAD JUMPSCARE
--//==================================================

local function LoadJumpscareAsset()
	-- Check executor support
	if not writefile or not isfile or not getcustomasset then
		warn(
			"Smiler Jumpscare: writefile/isfile/getcustomasset is not supported."
		)

		return nil
	end

	-- Download
	local success, result = pcall(function()

		if not isfile(JUMPSCARE_FILE) then
			local data = game:HttpGet(JUMPSCARE_URL)

			if not data or #data == 0 then
				error("Downloaded GIF is empty")
			end

			writefile(JUMPSCARE_FILE, data)
		end

		return getcustomasset(JUMPSCARE_FILE)
	end)

	if success and result then
		print("Smiler Jumpscare loaded")
		return result
	end

	warn("Smiler Jumpscare failed to load:", result)

	return nil
end

local JUMPSCARE_ASSET = LoadJumpscareAsset()

--//==================================================
--// SHOW JUMPSCARE
--//==================================================

local function ShowJumpscare()
	if jumpscareShown then
		return
	end

	jumpscareShown = true

	local PlayerGui = player:FindFirstChildOfClass("PlayerGui")

	if not PlayerGui then
		return
	end

	-- Remove previous GUI
	local oldGui = PlayerGui:FindFirstChild("SmilerJumpscare")

	if oldGui then
		oldGui:Destroy()
	end

	-- ScreenGui
	local Gui = Instance.new("ScreenGui")

	Gui.Name = "SmilerJumpscare"
	Gui.IgnoreGuiInset = true
	Gui.ResetOnSpawn = false
	Gui.DisplayOrder = 999999
	Gui.ZIndexBehavior = Enum.ZIndexBehavior.Global

	Gui.Parent = PlayerGui

	-- Full screen image
	local Image = Instance.new("ImageLabel")

	Image.Name = "Jumpscare"
	Image.BackgroundColor3 = Color3.new(0, 0, 0)
	Image.BackgroundTransparency = 0
	Image.BorderSizePixel = 0

	Image.Position = UDim2.fromScale(0, 0)
	Image.Size = UDim2.fromScale(1, 1)

	Image.AnchorPoint = Vector2.new(0, 0)
	Image.ScaleType = Enum.ScaleType.Stretch

	Image.ZIndex = 999999

	Image.Parent = Gui

	-- Load GIF
	if JUMPSCARE_ASSET then
		Image.Image = JUMPSCARE_ASSET
	else
		warn("Smiler Jumpscare: no image asset available")
	end

	-- Keep jumpscare for 3 seconds
	task.delay(3, function()

		if Gui and Gui.Parent then
			Gui:Destroy()
		end

	end)
end

--//==================================================
--// HEALTH MONITOR
--//==================================================

local function SetupHealthMonitor()

	if healthConnection then
		healthConnection:Disconnect()
		healthConnection = nil
	end

	local character = player.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	healthConnection =
		humanoid.HealthChanged:Connect(function(health)

			print("Smiler health check:", health)

			-- Jumpscare at 1 HP or 0 HP
			if health <= 1 then
				ShowJumpscare()
			end

		end)

	-- Check current health immediately
	if humanoid.Health <= 1 then
		ShowJumpscare()
	end
end

--//==================================================
--// CHARACTER RESPAWN
--//==================================================

player.CharacterAdded:Connect(function()

	jumpscareShown = false

	task.wait(1)

	SetupHealthMonitor()

end)

if player.Character then

	task.spawn(function()

		task.wait(1)

		SetupHealthMonitor()

	end)

end

--//==================================================
--// WAIT FOR SMILER TO DISAPPEAR
--//==================================================

local function WaitForSmilerToDisappear(model)

	if not model then
		GiveAchievement()
		return
	end

	local startTime = tick()

	while model.Parent and
		(tick() - startTime) < 10 do

		task.wait(0.05)

	end

	task.wait(0.1)

	if not model.Parent then
		GiveAchievement()
	end
end

