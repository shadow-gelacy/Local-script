
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local LocalPlayer = Players.LocalPlayer

local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"))()
local Achievement = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()

local MODEL_ID = "rbxassetid://16618965725"
local CRUCIFIX_COLOR = Color3.fromRGB(255, 60, 60)
local achievementGiven, jumpscarePlaying = false, false

local function ConfigureCrucifix(model)
    if not model or not model:IsA("Model") then return end

    model:SetAttribute("IsCustomEntity", true)
    model:SetAttribute("EntityName", "Smiler")
    model:SetAttribute("CrucifixCompatible", true)
    model:SetAttribute("CanBeCrucified", true)
    model:SetAttribute("CrucifixResist", false)
    model:SetAttribute("CrucifixColor", CRUCIFIX_COLOR)
    model:SetAttribute("GoingToHell", false)

    if not model.PrimaryPart then
        model.PrimaryPart = model:FindFirstChild("HumanoidRootPart", true)
            or model:FindFirstChild("Root", true)
            or model:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function playJumpscare()
    if jumpscarePlaying then return end
    jumpscarePlaying = true

    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    local camera = Workspace.CurrentCamera

    if not playerGui or not camera then
        jumpscarePlaying = false
        return
    end

    local oldFov, oldType, oldSubject = camera.FieldOfView, camera.CameraType, camera.CameraSubject
    local gui, sound

    local success, err = pcall(function()
        gui = Instance.new("ScreenGui")
        gui.Name = "SmilerJumpscare"
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10000
        gui.ResetOnSpawn = false
        gui.Parent = playerGui

        local background = Instance.new("ImageLabel")
        background.Size = UDim2.fromScale(1, 1)
        background.BackgroundColor3 = Color3.new(0, 0, 0)
        background.Image = "rbxassetid://78759941702772"
        background.ImageTransparency = 0.5
        background.ScaleType = Enum.ScaleType.Stretch
        background.Parent = gui

        local face = Instance.new("ImageLabel")
        face.AnchorPoint = Vector2.new(0.5, 0.5)
        face.Position = UDim2.fromScale(0.5, 0.589)
        face.Size = UDim2.fromOffset(1, 1)
        face.BackgroundTransparency = 1
        face.Image = "rbxassetid://107386174037977"
        face.ScaleType = Enum.ScaleType.Fit
        face.Parent = gui

        local textImage = Instance.new("ImageLabel")
        textImage.AnchorPoint = Vector2.new(0.5, 0.5)
        textImage.Position = UDim2.fromScale(0.5, 0.5)
        textImage.Size = UDim2.fromOffset(150, 150)
        textImage.BackgroundTransparency = 1
        textImage.Image = "rbxassetid://0"
        textImage.Parent = gui

        sound = Instance.new("Sound")
        sound.SoundId = "rbxassetid://5263560566"
        sound.Volume = 10
        sound.Looped = true
        sound.Parent = Workspace

        local flange = Instance.new("FlangeSoundEffect")
        flange.Rate = 0.2
        flange.Parent = sound

        local tremolo = Instance.new("TremoloSoundEffect")
        tremolo.Frequency = 1
        tremolo.Parent = sound

        local pitch = Instance.new("PitchShiftSoundEffect")
        pitch.Octave = 1
        pitch.Parent = sound

        local distortion = Instance.new("DistortionSoundEffect")
        distortion.Level = 0.2
        distortion.Parent = sound

        sound:Play()
        camera.CameraType = Enum.CameraType.Scriptable

        local duration = 1.1
        TweenService:Create(camera, TweenInfo.new(duration), {
            FieldOfView = 60
        }):Play()

        TweenService:Create(face, TweenInfo.new(duration), {
            Size = UDim2.fromOffset(1200, 1200),
            Position = UDim2.fromScale(0.5, 0.5)
        }):Play()

        local running = true

        task.spawn(function()
            while running and gui.Parent do
                background.ImageTransparency = 0.3
                task.wait(0.1)
                if not running then break end
                background.ImageTransparency = 0
                background.BackgroundTransparency = 0.3
                task.wait(0.1)
            end
        end)

        task.spawn(function()
            while running and gui.Parent do
                face.Rotation = 10
                task.wait()
                if not running then break end
                face.Rotation = -10
                task.wait()
            end
        end)

        task.spawn(function()
            while running and gui.Parent do
                textImage.ImageTransparency = 0
                textImage.Position = UDim2.new(math.random(), 0, math.random(), 0)
                task.wait(0.1)
                textImage.ImageTransparency = 1
                task.wait(0.1)
            end
        end)

        task.wait(duration)
        running = false
        sound:Stop()

        for _, object in ipairs({face, textImage, background}) do
            TweenService:Create(object, TweenInfo.new(0.5), {
                ImageTransparency = 1,
                BackgroundTransparency = 1
            }):Play()
        end

        task.wait(0.6)
    end)

    if sound then sound:Destroy() end
    if gui then gui:Destroy() end

    if camera.Parent then
        camera.CameraType = oldType
        camera.FieldOfView = oldFov
        if oldSubject and oldSubject.Parent then
            camera.CameraSubject = oldSubject
        end
    end

    jumpscarePlaying = false
    if not success then warn("[Smiler] Jumpscare error:", err) end
end

