
local function PlayJumpscare()
    if jumpscarePlaying then return end
    jumpscarePlaying = true

    local playerGui = Player:FindFirstChildOfClass("PlayerGui")
    local camera = Workspace.CurrentCamera

    if not playerGui or not camera then
        jumpscarePlaying = false
        return
    end

    local oldFov = camera.FieldOfView
    local oldType = camera.CameraType
    local oldSubject = camera.CameraSubject
    local gui, sound
    local success, err = pcall(function()
        gui = Instance.new("ScreenGui")
        gui.Name = "SmilerJumpscare"
        gui.IgnoreGuiInset = true
        gui.DisplayOrder = 10000
        gui.ResetOnSpawn = false
        gui.Parent = playerGui

        local redFlash = Instance.new("Frame")
        redFlash.Size = UDim2.fromScale(1, 1)
        redFlash.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        redFlash.BackgroundTransparency = 0.25
        redFlash.BorderSizePixel = 0
        redFlash.ZIndex = 2
        redFlash.Parent = gui

        local face = Instance.new("ImageLabel")
        face.Name = "SmilerFace"
        face.AnchorPoint = Vector2.new(0.5, 0.5)
        face.Position = UDim2.fromScale(0.5, 0.589)
        face.Size = UDim2.fromOffset(1, 1)
        face.BackgroundTransparency = 1
        face.Image = FACE_ID
        face.ScaleType = Enum.ScaleType.Fit
        face.ZIndex = 3
        face.Parent = gui

        sound = Instance.new("Sound")
        sound.Name = "SmilerSound"
        sound.SoundId = SOUND_ID
        sound.Volume = 10
        sound.Looped = true
        sound.Parent = Workspace

        local flange = Instance.new("FlangeSoundEffect")
        flange.Rate = 0.2
        flange.Parent = sound

        local tremolo = Instance.new("TremoloSoundEffect")
        tremolo.Frequency = 1
        tremolo.Parent = sound

        local pitch = Instance.new("PitchShiftSoundEffect")
        pitch.Octave = 1
        pitch.Parent = sound

        local distortion = Instance.new("DistortionSoundEffect")
        distortion.Level = 0.2
        distortion.Parent = sound

        sound:Play()
        camera.CameraType = Enum.CameraType.Scriptable

        local duration = 1.1

        TweenService:Create(
            camera,
            TweenInfo.new(duration),
            {FieldOfView = 60}
        ):Play()

        TweenService:Create(
            face,
            TweenInfo.new(duration),
            {
                Size = UDim2.fromOffset(1200, 1200),
                Position = UDim2.fromScale(0.5, 0.5)
            }
        ):Play()

        local running = true

        task.spawn(function()
            while running and gui.Parent do
                redFlash.BackgroundTransparency = 0.15
                task.wait(0.07)
                if not running then break end

                redFlash.BackgroundTransparency = 0.85
                task.wait(0.07)

                if not running then break end
                redFlash.BackgroundTransparency = 0.35
                task.wait(0.07)

                if not running then break end
                redFlash.BackgroundTransparency = 1
                task.wait(0.07)
            end
        end)

        task.spawn(function()
            while running and gui.Parent do
                face.Rotation = 10
                task.wait(0.04)
                if not running then break end

                face.Rotation = -10
                task.wait(0.04)
            end
        end)

        task.wait(duration)
        running = false

        sound:Stop()

        TweenService:Create(
            face,
            TweenInfo.new(0.5),
            {ImageTransparency = 1}
        ):Play()

        TweenService:Create(
            redFlash,
            TweenInfo.new(0.5),
            {BackgroundTransparency = 1}
        ):Play()

        task.wait(0.6)
    end)

    if sound then
        sound:Destroy()
    end

    if gui then
        gui:Destroy()
    end

    if camera and camera.Parent then
        camera.CameraType = oldType
        camera.FieldOfView = oldFov

        if oldSubject and oldSubject.Parent then
            camera.CameraSubject = oldSubject
        end
    end

    jumpscarePlaying = false

    if not success then
        warn("[Smiler] Jumpscare error:", err)
    end
end
