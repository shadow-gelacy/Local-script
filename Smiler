    },

    Death = {
        Type = "Guiding",
        Hints = {
            "remember that is",
            "smiler"
        },
        Cause = "smiler"
    }
})

Entity:SetCallback("OnSpawned", function()
    task.wait(0.1)

    if Entity.Model then
        ConfigureCrucifix(Entity.Model)
    end
end)

Entity:SetCallback("OnDespawned", function()
    if achievementGiven then
        return
    end

    achievementGiven = true

    pcall(function()
        Achievement({
            Title = "how why?",
            Desc = "Don't leave hiding spot",
            Reason = "Encounter smiler.",
