local OriginalLighting = {
	Brightness = Lighting.Brightness,
	ExposureCompensation = Lighting.ExposureCompensation,
	GlobalShadows = Lighting.GlobalShadows
}

--//==================================================
--// SAVE ORIGINAL LIGHTS
--//==================================================

local OriginalLights = {}

local function SaveLight(light)
	if not (
		light:IsA("PointLight")
		or light:IsA("SpotLight")
		or light:IsA("SurfaceLight")
	) then
		return
	end

	if OriginalLights[light] then
		return
	end

	OriginalLights[light] = {
		Color = light.Color,
		Brightness = light.Brightness,
		Shadows = light.Shadows
	}
end

for _, object in ipairs(Workspace:GetDescendants()) do
	SaveLight(object)
end

Debug("Saved original lights:", #OriginalLights)

--//==================================================
--// RED & BLACK EFFECT
--//==================================================

for _, effectName in ipairs({
	"RedBlackColorCorrection",
	"RedBlackBloom"
}) do
	local oldEffect = Lighting:FindFirstChild(effectName)

	if oldEffect then
		pcall(function()
			oldEffect:Destroy()
		end)

		Debug("Removed old effect:", effectName)
	end
end

local RedCorrection = Instance.new("ColorCorrectionEffect")

RedCorrection.Name = "RedBlackColorCorrection"

RedCorrection.Brightness = -0.03
RedCorrection.Contrast = 0.65
RedCorrection.Saturation = 0.15
RedCorrection.TintColor = Color3.fromRGB(255, 235, 235)

RedCorrection.Parent = Lighting

local RedBloom = Instance.new("BloomEffect")

RedBloom.Name = "RedBlackBloom"

RedBloom.Intensity = 0.45
RedBloom.Size = 12
RedBloom.Threshold = 0.75

RedBloom.Parent = Lighting

--//==================================================
--// RED LIGHT EFFECT
--//==================================================

local RedEffectActive = true
local RedFadeStarted = false

local RED_COLOR = Color3.fromRGB(255, 0, 0)

local function ApplyRedLight(light)
	if not (
		light:IsA("PointLight")
		or light:IsA("SpotLight")
		or light:IsA("SurfaceLight")
	) then
		return
	end

	SaveLight(light)

	pcall(function()
		light.Color = RED_COLOR

		if light.Brightness < 2.5 then
			light.Brightness = 2.5
		end

		light.Shadows = true
	end)
end

local function StartRedEffect()

	Debug("Starting RED & BLACK effect.")

	pcall(function()
		Lighting.Brightness = 1.5
		Lighting.GlobalShadows = true
		Lighting.ExposureCompensation = -0.15
	end)

	for _, object in ipairs(Workspace:GetDescendants()) do
		if object:IsA("PointLight")
			or object:IsA("SpotLight")
			or object:IsA("SurfaceLight") then

			ApplyRedLight(object)
		end
	end

	Debug("Existing lights changed to red.")
end

StartRedEffect()

--//==================================================
--// MONITOR NEW LIGHTS
--//==================================================

Workspace.DescendantAdded:Connect(function(object)

	if not RedEffectActive then
		return
	end

	if object:IsA("PointLight")
		or object:IsA("SpotLight")
		or object:IsA("SurfaceLight") then

		task.wait()

		if RedEffectActive then
			ApplyRedLight(object)
		end
	end
end)

--//==================================================
--// FADE RED EFFECT
--//==================================================

local function FadeRedEffect()

	if RedFadeStarted then
		return
	end

	RedFadeStarted = true
	RedEffectActive = false

	Debug("======================================")
	Debug("START SOUND FINISHED")
	Debug("FADING RED EFFECT")
	Debug("======================================")

	local tweenInfo = TweenInfo.new(
		RED_FADE_TIME,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	--// Restore lights
	for light, original in pairs(OriginalLights) do

		if light and light.Parent then

			pcall(function()

				TweenService:Create(
					light,
					tweenInfo,
					{
						Color = original.Color,
						Brightness = original.Brightness
					}
				):Play()

				task.delay(RED_FADE_TIME, function()

					if light and light.Parent then

						pcall(function()
							light.Shadows = original.Shadows
						end)

					end
				end)

			end)
		end
	end

	--// Restore Lighting
	pcall(function()

		TweenService:Create(
			Lighting,
			tweenInfo,
			{
				Brightness = OriginalLighting.Brightness,
				ExposureCompensation = OriginalLighting.ExposureCompensation
			}
		):Play()

		task.delay(RED_FADE_TIME, function()

			pcall(function()
				Lighting.GlobalShadows = OriginalLighting.GlobalShadows
			end)

		end)

	end)

	--// Fade ColorCorrection
	pcall(function()

		TweenService:Create(
			RedCorrection,
			tweenInfo,
			{
				Brightness = 0,
				Contrast = 0,
				Saturation = 0,
				TintColor = Color3.fromRGB(255, 255, 255)
			}
		):Play()

	end)

	--// Fade Bloom
	pcall(function()

		TweenService:Create(
			RedBloom,
			tweenInfo,
			{
				Intensity = 0,
				Size = 0
			}
		):Play()

	end)

	task.delay(RED_FADE_TIME + 0.2, function()

		pcall(function()

			if RedCorrection then
				RedCorrection:Destroy()
			end

			if RedBloom then
				RedBloom:Destroy()
			end

		end)

		Debug("RED & BLACK EFFECT ENDED.")
	end)
end

